# bee — пример настроек со всеми ключами и их дефолтами.
# Обязательны только хранилище (BEE_STORAGE и ключи выбранного вида) и хотя
# бы один транспорт (BEE_HTTP_ADDR, BEE_GRPC_ADDR или BEE_NATS_URL).
# Остальные строки показывают дефолт: их можно удалить, значение не изменится.
# Настоящий env важнее этого файла. Длительности — Go (0s, 90s, 5m, 24h).

# --- хранилище (обязательно) ---------------------------------------------
# s3 или local
BEE_STORAGE=local
# local: корневая папка результатов
BEE_LOCAL_DIR=/data/out
# s3: провайдер из pkg/storage/s3/provider (cloudflare, hetzner, aws, minio, ...)
# BEE_S3_PROVIDER=cloudflare
# BEE_S3_KEY=
# BEE_S3_SECRET=
# BEE_S3_BUCKET=
# пусто — endpoint по шаблону провайдера
# BEE_S3_ENDPOINT=
# пусто — регион провайдера (r2 всегда auto)
# BEE_S3_REGION=
# cloudflare account id и т.п., если его требует endpoint провайдера
# BEE_S3_ACCOUNT=
# папка внутри бакета; пусто — корень
# BEE_S3_PREFIX=
# https; учитывается только у своих (minio, ceph)
BEE_S3_SECURE=true

# --- транспорты (обязателен хотя бы один) ---------------------------------
# http: job, health, metrics
BEE_HTTP_ADDR=:8080
# grpc; пусто — выключен
# BEE_GRPC_ADDR=:9090
# nats jetstream; пусто — выключен
# BEE_NATS_URL=nats://nats:4222
# имя stream, subjects и consumer этого bee
BEE_NATS_NAME=bee
BEE_NATS_ACK_WAIT=1m
BEE_NATS_MAX_DELIVER=5
BEE_NATS_RETRY_DELAY=10s
BEE_NATS_RETRY_MAX_DELAY=5m
# file или memory
BEE_NATS_STORAGE=file
BEE_NATS_REPLICAS=1
# 0s — никогда
BEE_NATS_MAX_AGE=0s
BEE_NATS_RESULT_TTL=24h

# --- общие ------------------------------------------------------------------
BEE_WORKER_ID=bee-1
BEE_TEMP_DIR=/tmp/bee
# job одновременно, все типы вместе
BEE_CONCURRENCY=2
# 0s — сразу отказ, если все слоты заняты
BEE_QUEUE_WAIT=0s
# скачивание всех url одной job; не больше таймаута любого типа
BEE_DOWNLOAD_TIMEOUT=2m
BEE_UPLOAD_CONCURRENCY=8
BEE_SHUTDOWN_TIMEOUT=2m
# токен http и grpc; пусто — без проверки
BEE_TOKEN=
# разрешённые хосты url через запятую (по суффиксу); пусто — любой публичный
BEE_SOURCE_HOSTS=
# true разрешает http и приватные адреса: только разработка и тесты
BEE_ALLOW_INSECURE_SOURCE=false

# --- бинарники --------------------------------------------------------------
BEE_FFMPEG=ffmpeg
BEE_FFPROBE=ffprobe
BEE_FPCALC=fpcalc
BEE_VIPS=vips
BEE_VIPSHEADER=vipsheader

# --- аудио ------------------------------------------------------------------
# лимиты сервера: job их не меняет
BEE_AUDIO_TIMEOUT=5m
BEE_AUDIO_MAX_SOURCE_MB=500
BEE_AUDIO_MIN_DURATION=1s
BEE_AUDIO_MAX_DURATION=30m
# дефолты для пустых полей job
BEE_AUDIO_LUFS=-14
BEE_AUDIO_TRUE_PEAK=-1.5
BEE_AUDIO_RENDITIONS=128,64,256
BEE_AUDIO_SAMPLE_RATE=44100
BEE_AUDIO_CHANNELS=2
BEE_AUDIO_SEGMENT=6
BEE_AUDIO_WAVEFORM_PPS=100
BEE_AUDIO_WAVEFORM_POINTS=512
BEE_AUDIO_ANALYSIS=false
# нужен BEE_FPCALC
BEE_AUDIO_FINGERPRINT=false
BEE_AUDIO_SILENCE_DB=-60
BEE_AUDIO_SILENCE_SEC=2

# --- видео ------------------------------------------------------------------
# лимиты сервера: job их не меняет
BEE_VIDEO_TIMEOUT=10m
BEE_VIDEO_MAX_SOURCE_MB=500
BEE_VIDEO_MIN_DURATION=1s
BEE_VIDEO_MAX_DURATION=5m
BEE_VIDEO_MAX_DIMENSION=3840
BEE_VIDEO_THREADS=4
# дефолты для пустых полей job
BEE_VIDEO_SOUND_BITRATE=128
BEE_VIDEO_WATERMARK_WIDTH=160
BEE_VIDEO_IMAGE_QUALITY=80
BEE_VIDEO_LUFS=-16
BEE_VIDEO_TRUE_PEAK=-1.5

# --- картинки ---------------------------------------------------------------
# лимиты сервера: job их не меняет
BEE_IMAGES_TIMEOUT=2m
BEE_IMAGES_MAX_SOURCE_MB=50
BEE_IMAGES_MAX_MEGAPIXELS=100
BEE_IMAGES_MAX_DIMENSION=8000
BEE_IMAGES_THREADS=4
# дефолты для пустых полей job
BEE_IMAGES_MIN_QUALITY=30
BEE_IMAGES_AVIF_EFFORT=4
