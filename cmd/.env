# bee: an example with every key and its default.
# Required: the storage (BEE_STORAGE and the keys of its kind), at least one
# transport (BEE_HTTP_ADDR, BEE_GRPC_ADDR or BEE_NATS_URL) and BEE_TOKEN with
# http or grpc. Every other line shows a default: removing it changes nothing.
# The real environment wins over this file. Durations are Go (0s, 90s, 5m, 24h).

# --- storage (required) -------------------------------------------------------
# s3 or local
BEE_STORAGE=local
# local: the root folder of the outputs
BEE_LOCAL_DIR=/data/out
# s3: a provider of pkg/storage/s3/provider (cloudflare, hetzner, aws, minio, ...)
# BEE_S3_PROVIDER=cloudflare
# BEE_S3_KEY=
# BEE_S3_SECRET=
# BEE_S3_BUCKET=
# empty: the endpoint template of the provider
# BEE_S3_ENDPOINT=
# empty: the region of the provider (r2 is always auto)
# BEE_S3_REGION=
# cloudflare account id and alike, when the endpoint of the provider needs it
# BEE_S3_ACCOUNT=
# a folder inside the bucket; empty: the root
# BEE_S3_PREFIX=
# https; counts only for self-hosted providers (minio, ceph)
BEE_S3_SECURE=true

# --- transports (at least one is required) ------------------------------------
# http: jobs only, needs BEE_TOKEN
BEE_HTTP_ADDR=:8080
# grpc, needs BEE_TOKEN; empty: off
# BEE_GRPC_ADDR=:9090
# the token of http and grpc ("Authorization: Bearer <token>"); required with them
BEE_TOKEN=change-me
# nats jetstream (BEE_TOKEN is not used); empty: off
# BEE_NATS_URL=nats://nats:4222
# nats auth token; empty: none
# BEE_NATS_TOKEN=
# subject bases: jobs on <jobs>.<kind>, results on <done>.<kind>.<id>;
# stream, consumer and ledger names derive from them (bee.jobs.new: BEE_JOBS_NEW)
BEE_NATS_JOBS=bee.jobs.new
BEE_NATS_DONE=bee.jobs.done
BEE_NATS_ACK_WAIT=1m
BEE_NATS_MAX_DELIVER=5
BEE_NATS_RETRY_DELAY=10s
BEE_NATS_RETRY_MAX_DELAY=5m
# file or memory
BEE_NATS_STORAGE=file
BEE_NATS_REPLICAS=1
# 0s: never
BEE_NATS_MAX_AGE=0s
BEE_NATS_RESULT_TTL=24h

# --- health (always on, no token): /health, /ready, /metrics ------------------
BEE_HEALTH_ADDR=:8081

# --- common -------------------------------------------------------------------
BEE_WORKER_ID=bee-1
BEE_TEMP_DIR=/tmp/bee
# jobs at once, every type together
BEE_CONCURRENCY=2
# 0s: refuse at once when every slot is busy
BEE_QUEUE_WAIT=0s
# the downloads of one job; at most the timeout of any type
BEE_DOWNLOAD_TIMEOUT=2m
BEE_UPLOAD_CONCURRENCY=8
BEE_SHUTDOWN_TIMEOUT=2m
# allowed url hosts, comma separated (suffix match); empty: any public host
BEE_SOURCE_HOSTS=
# true allows http and private addresses: development and tests only
BEE_ALLOW_INSECURE_SOURCE=false

# --- binaries -----------------------------------------------------------------
BEE_FFMPEG=ffmpeg
BEE_FFPROBE=ffprobe
# not in PATH: fingerprint is off (an empty value keeps the default)
BEE_FPCALC=fpcalc
BEE_VIPS=vips
BEE_VIPSHEADER=vipsheader

# --- audio --------------------------------------------------------------------
# server limits: a job never changes them
BEE_AUDIO_TIMEOUT=5m
BEE_AUDIO_MAX_SOURCE_MB=500
BEE_AUDIO_MIN_DURATION=1s
BEE_AUDIO_MAX_DURATION=30m
# defaults of empty job fields
BEE_AUDIO_LUFS=-14
BEE_AUDIO_TRUE_PEAK=-1.5
BEE_AUDIO_RENDITIONS=128,64,256
BEE_AUDIO_SAMPLE_RATE=44100
BEE_AUDIO_CHANNELS=2
BEE_AUDIO_SEGMENT=6
BEE_AUDIO_WAVEFORM_PPS=100
BEE_AUDIO_WAVEFORM_POINTS=512
BEE_AUDIO_ANALYSIS=false
# needs BEE_FPCALC
BEE_AUDIO_FINGERPRINT=false
BEE_AUDIO_SILENCE_DB=-60
BEE_AUDIO_SILENCE_SEC=2

# --- video --------------------------------------------------------------------
# server limits: a job never changes them
BEE_VIDEO_TIMEOUT=10m
BEE_VIDEO_MAX_SOURCE_MB=500
BEE_VIDEO_MIN_DURATION=1s
BEE_VIDEO_MAX_DURATION=5m
BEE_VIDEO_MAX_DIMENSION=3840
BEE_VIDEO_THREADS=4
# defaults of empty job fields
BEE_VIDEO_SOUND_BITRATE=128
BEE_VIDEO_WATERMARK_WIDTH=160
BEE_VIDEO_IMAGE_QUALITY=80
BEE_VIDEO_LUFS=-16
BEE_VIDEO_TRUE_PEAK=-1.5

# --- images -------------------------------------------------------------------
# server limits: a job never changes them
BEE_IMAGES_TIMEOUT=2m
BEE_IMAGES_MAX_SOURCE_MB=50
BEE_IMAGES_MAX_MEGAPIXELS=100
BEE_IMAGES_MAX_DIMENSION=8000
BEE_IMAGES_THREADS=4
# defaults of empty job fields
BEE_IMAGES_MIN_QUALITY=30
BEE_IMAGES_AVIF_EFFORT=4
