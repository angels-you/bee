package code

// name=Code type=string
DOWNLOAD_TIMEOUT         // @retryable=true @redeliver=true desc{a download by a url of the job (source, sound, watermark) did not finish within BEE_DOWNLOAD_TIMEOUT}
SOURCE_URL_EXPIRED       // @retryable=true @redeliver=false desc{a presigned url expired: the same job fails again, send a new job with a fresh url}
SOURCE_UNAVAILABLE       // @retryable=true @redeliver=true desc{a download failed: network error, access denied or an unexpected http status}
STORAGE_TIMEOUT          // @retryable=true @redeliver=true desc{a write to the storage or the check of an output key timed out}
STORAGE_UNAVAILABLE      // @retryable=true @redeliver=true desc{a write to the storage or the check of an output key failed}
INTERNAL_TEMPORARY_ERROR // @retryable=true @redeliver=true desc{busy, cancelled, timed out or an unexpected failure of bee}
INVALID_JOB              // @retryable=false @redeliver=false desc{the job is malformed: id, urls, options, profiles, tasks}
INVALID_PATH             // @retryable=false @redeliver=false desc{an output key is empty, not a clean relative key, has the wrong extension or is used twice}
INVALID_DIMENSIONS       // @retryable=false @redeliver=false desc{a size of the job is odd, negative, missing or above the limit of bee}
INVALID_QUALITY          // @retryable=false @redeliver=false desc{a quality is outside 0..100 or missing where it is required}
UNSUPPORTED_CODEC        // @retryable=false @redeliver=false desc{the job asks for a codec, pixel format, preset or image format bee does not encode}
UNSUPPORTED_FORMAT       // @retryable=false @redeliver=false desc{the container or codec of the source is one bee does not accept}
INVALID_AUDIO            // @retryable=false @redeliver=false desc{the audio is empty, corrupted, silent or has no audio stream}
INVALID_VIDEO            // @retryable=false @redeliver=false desc{the video is empty, corrupted, has no video stream or cannot be decoded}
INVALID_IMAGE            // @retryable=false @redeliver=false desc{the image is empty, corrupted or cannot be decoded}
INVALID_SOUND            // @retryable=false @redeliver=false desc{the external sound of a video job is empty, corrupted or has no audio stream}
INVALID_WATERMARK        // @retryable=false @redeliver=false desc{the watermark is empty, corrupted or not a still image}
SOURCE_TOO_LARGE         // @retryable=false @redeliver=false desc{a downloaded file is bigger than the limit of bee}
DIMENSION_LIMIT_EXCEEDED // @retryable=false @redeliver=false desc{the source frame is larger than the limit of bee on a side}
PIXEL_LIMIT_EXCEEDED     // @retryable=false @redeliver=false desc{the source image has more pixels than the limit of bee}
DURATION_LIMIT_EXCEEDED  // @retryable=false @redeliver=false desc{the source or the processed timeline is shorter or longer than the limits of bee}
NO_RENDITION             // @retryable=false @redeliver=false desc{without upscale no profile fits the source: every rendition would be larger than the source}
OUTPUT_TOO_LARGE         // @retryable=false @redeliver=false desc{an output stays above its max_bytes even at the lowest quality}
ENCODE_FAILED            // @retryable=false @redeliver=false desc{ffmpeg or vips failed on an accepted source}
VERIFY_FAILED            // @retryable=false @redeliver=false desc{an output did not pass the check: stream, size, duration or segments}
